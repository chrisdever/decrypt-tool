            <label>密钥 (Hex，16字节)</label>
            <input type="text" id="sm4-key" placeholder="例如: 0123456789abedef0123456789abedef">
          </div>
          <button class="btn btn-primary" onclick="decryptSM4()">🔓 SM4 解密</button>
          <button class="btn btn-secondary" onclick="encryptSM4()"> SM4 加密</button>
