        color: #e2e8f0;
        min-height: 100vh;
        padding: 20px;
      }
      .container { max-width: 1200px; margin: 0 auto; }
      h1 {
        text-align: center;
        margin-bottom: 10px;
        background: linear-gradient(90deg, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2rem;
      }
      .subtitle {
        text-align: center;
        color: #94a3b8;
        margin-bottom: 30px;
        font-size: 0.9rem;
      }
      .tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 20px;
        background: #1e293b;
        padding: 4px;
        border-radius: 12px;
        overflow-x: auto;
      }
      .tab {
        flex: 1;
        min-width: 120px;
        padding: 10px 16px;
        border: none;
        background: transparent;
