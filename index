      window.decryptSM4 = async function() {
        try {
          await loadSmCrypto();
          const cipher = document.getElementById('sm4-cipher').value.trim();
          const key = document.getElementById('sm4-key').value.trim();
          if (!cipher || !key) return showResult('sm4-result', '请输入密文和密钥', true);

          const decrypted = sm4Instance.decrypt(cipher, key);
          showResult('sm4-result', decrypted || '(解密结果为空)');
        } catch (e) {
          showResult('sm4-result', 'SM4解密失败: ' + e.message, true);
        }
      };

      window.encryptSM4 = async function() {
        try {
          await loadSmCrypto();
          const plain = document.getElementById('sm4-cipher').value.trim();
          const key = document.getElementById('sm4-key').value.trim();
          if (!key) return showResult('sm4-result', '请输入密钥', true);

          const encrypted = sm4Instance.encrypt(plain, key);
          showResult('sm4-result', encrypted);
        } catch (e) {
          showResult('sm4-result', 'SM4加密失败: ' + e.message, true);
        }
      };

      // ========== 混合解密 ==========
      window.decryptHybrid = async function() {
        try {
          await loadSmCrypto();
          const jsonStr = document.getElementById('hybrid-json').value.trim();
          const privateKey = document.getElementById('hybrid-private-key').value.trim();
          const publicKey = document.getElementById('hybrid-public-key').value.trim();
          const verify = document.getElementById('hybrid-verify').checked;

          if (!jsonStr || !privateKey) return showResult('hybrid-result', '请输入响应体和私钥', true);

          const body = JSON.parse(jsonStr);
          const { time, data, sm4Key, sign } = body;

          let result = '【混合解密结果】\n\n';

          // 1. 验签（可选）
          if (verify && sign && publicKey) {
            result += '1. 签名验证: (需项目buildSignMessage实现)\n   跳过...\n\n';
          }

          // 2. 解密 sm4Key (如果存在)
          if (sm4Key && sm4Key.startsWith('04')) {
            const rawSm4Key = sm2Instance.doDecrypt(sm4Key.substring(2), privateKey, 1);
            result += '2. SM2 解密密钥: ' + rawSm4Key + '\n\n';

            // 3. SM4 解密 data
            if (data) {
              const decrypted = sm4Instance.decrypt(data, rawSm4Key);
              result += '3. SM4 解密数据: \n' + decrypted;
            }
          } else if (data) {
            // 兼容纯 SM2 加密
            const raw = data.startsWith('04') ? data.substring(2) : data;
            const decrypted = sm2Instance.doDecrypt(raw, privateKey, 1);
            result += '2. SM2 解密数据: \n' + decrypted;
          }

          showResult('hybrid-result', result);
        } catch (e) {
          showResult('hybrid-result', '混合解密失败: ' + e.message, true);
        }
      };

