  <body>
    <div class="container">
      <h1>🔓 项目加密调试工具</h1>
      <p class="subtitle">支持 AES / RSA / SM2 / SM4 / SM2+SM4混合解密</p>

      <div class="tabs-wrapper">
        <div class="tabs">
          <button class="tab active" data-tab="aes">AES (CryptoJS)</button>
          <button class="tab" data-tab="rsa">RSA (JSEncrypt)</button>
          <button class="tab" data-tab="sm2">SM2 国密</button>
          <button class="tab" data-tab="sm4">SM4 国密</button>
          <button class="tab" data-tab="hybrid">SM2+SM4 混合</button>
          <button class="tab" data-tab="utils">通用工具</button>
        </div>
      </div>

      <!-- AES 面板 -->
      <div class="panel active" id="panel-aes">
        <div class="card">
          <div class="card-title">🔑 AES 解密 (CBC/PKCS7)</div>
          <div class="form-group">
            <label>密文 (Base64，含IV前缀) <span class="key-badge" 
  onclick="fillExample('aes-cipher')">填入示例</span></label>
            <textarea id="aes-cipher" placeholder="粘贴Base64密文..."></textarea>
            <p class="hint">项目加密逻辑：IV(16字节) + 密文 → Base64编码</p>
          </div>
          <div class="form-group">
            <label>密钥 (Hex/Utf8)</label>
            <input type="text" id="aes-key" value="ASDKF32ERDSKFJAk" placeholder="密钥">
            <p class="hint">项目默认密钥：ASDKF32ERDSKFJAk (SECRET前16位)</p>
          </div>
          <div class="form-group">
            <label>编码方式</label>
            <select id="aes-key-type">
              <option value="utf8">UTF-8 (项目默认)</option>
              <option value="hex">Hex</option>
            </select>
          </div>
          <button class="btn btn-primary" onclick="decryptAES()">🔓 AES 解密</button>
          <button class="btn btn-secondary" onclick="encryptAES()"> AES 加密</button>
          <div class="result-wrapper">
            <div id="aes-result" class="result">结果将显示在这里...</div>
          </div>
        </div>
      </div>

      <!-- RSA 面板 -->
      <div class="panel" id="panel-rsa">
        <div class="card">
          <div class="card-title">🔑 RSA 解密 (JSEncrypt)</div>
          <div class="form-group">
            <label>密文 (Base64)</label>
            <textarea id="rsa-cipher" placeholder="粘贴RSA加密后的Base64密文..."></textarea>
          </div>
          <div class="form-group">
            <label>私钥 (PKCS#1)</label>
            <textarea id="rsa-private-key" style="min-height:200px;" placeholder="粘贴PKCS#1格式私钥..."></textarea>
            <p class="hint">预填了项目中的硬编码私钥，可修改</p>
          </div>
          <button class="btn btn-primary" onclick="decryptRSA()"> RSA 解密</button>
          <button class="btn btn-secondary" onclick="encryptRSA()">🔒 RSA 加密</button>
          <div class="result-wrapper">
            <div id="rsa-result" class="result">结果将显示在这里...</div>
          </div>
        </div>
      </div>

      <!-- SM2 面板 -->
