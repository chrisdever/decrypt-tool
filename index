            </div>
          </div>
          <div class="checkbox-group">
            <input type="checkbox" id="hybrid-verify" checked>
            <label for="hybrid-verify" style="margin:0;">验签（可选）</label>
          </div>
          <button class="btn btn-primary" onclick="decryptHybrid()">🔓 混合解密</button>
          <div class="result-wrapper">
            <div id="hybrid-result" class="result">结果将显示在这里...</div>
          </div>
        </div>
      </div>

      <!-- 通用工具面板 -->
      <div class="panel" id="panel-utils">
        <div class="card">
          <div class="card-title"> 通用编解码工具</div>
          <div class="form-group">
            <label>输入</label>
            <textarea id="util-input" style="min-height:80px;" placeholder="输入要处理的内容..."></textarea>
          </div>
          <div style="margin-bottom:16px;">
            <button class="btn btn-primary" onclick="utilBase64Encode()">Base64 编码</button>
            <button class="btn btn-secondary" onclick="utilBase64Decode()">Base64 解码</button>
            <button class="btn btn-secondary" onclick="utilURLEncode()">URL 编码</button>
            <button class="btn btn-secondary" onclick="utilURLDecode()">URL 解码</button>
            <button class="btn btn-secondary" onclick="utilHexEncode()">Hex 编码</button>
            <button class="btn btn-secondary" onclick="utilHexDecode()">Hex 解码</button>
            <button class="btn btn-secondary" onclick="utilJsonFormat()">JSON 格式化</button>
            <button class="btn btn-secondary" onclick="utilJsonMinify()">JSON 压缩</button>
          </div>
          <div class="result-wrapper">
            <div id="util-result" class="result">结果将显示在这里...</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // ========== Tab 切换 ==========
      document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
          document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
        });
      });

      // ========== 工具函数 ==========
      function showResult(id, text, isError) {
        const el = document.getElementById(id);
        el.textContent = text;
        el.className = 'result ' + (isError ? 'error' : 'success');
      }

      function fillExample(id) {
        const examples = {
          'aes-cipher': '请粘贴项目中通过 crypto.js 加密后的 Base64 密文',
          'hybrid-json': JSON.stringify({
            "time": "2024-01-01T12:00:00",
            "data": "SM4加密后的业务数据(Hex)",
            "sm4Key": "04...SM2加密的SM4密钥",
            "sign": "SM2签名值"
          }, null, 2)
        };
        document.getElementById(id).value = examples[id];
      }

      // ========== AES ==========
      function getAESKey(keyStr, type) {
        if (type === 'hex') return CryptoJS.enc.Hex.parse(keyStr);
        return CryptoJS.enc.Utf8.parse(keyStr);
      }

      window.decryptAES = function() {
        try {
          const cipher = document.getElementById('aes-cipher').value.trim();
          if (!cipher) return showResult('aes-result', '请输入密文', true);
          const keyStr = document.getElementById('aes-key').value;
          const keyType = document.getElementById('aes-key-type').value;
          const key = getAESKey(keyStr, keyType);

          // 项目逻辑：Base64 → 提取IV(16字节/4 words) + 密文
          const all = CryptoJS.enc.Base64.parse(cipher);
          if (all.sigBytes < 16) return showResult('aes-result', '密文太短，无法提取IV', true);

          const iv = CryptoJS.lib.WordArray.create(all.words.slice(0, 4), 16);
          const ct = CryptoJS.lib.WordArray.create(all.words.slice(4), all.sigBytes - 16);

          const decrypted = CryptoJS.AES.decrypt({ ciphertext: ct }, key, {
            iv: iv,
            mode: CryptoJS.mode.CBC,
            padding: CryptoJS.pad.Pkcs7,
          });

          const plain = CryptoJS.enc.Utf8.stringify(decrypted);
          showResult('aes-result', plain || '(解密结果为空，可能密钥不正确)');
        } catch (e) {
          showResult('aes-result', 'AES解密失败: ' + e.message, true);
        }
      };

      window.encryptAES = function() {
        try {
          const plain = document.getElementById('aes-cipher').value.trim();
          const keyStr = document.getElementById('aes-key').value;
          const keyType = document.getElementById('aes-key-type').value;
          const key = getAESKey(keyStr, keyType);

          // 项目bug：IV生成函数 randomIV 实际生成全0
          const iv = CryptoJS.lib.WordArray.create([0,0,0,0], 16);

          const encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(plain), key, {
            iv: iv,
            mode: CryptoJS.mode.CBC,
            padding: CryptoJS.pad.Pkcs7,
          });

          const all = iv.clone().concat(encrypted.ciphertext);
          const result = CryptoJS.enc.Base64.stringify(all);
          showResult('aes-result', result);
        } catch (e) {
          showResult('aes-result', 'AES加密失败: ' + e.message, true);
        }
      };

      // ========== RSA ==========
      const defaultPrivateKey =
  '';
      const defaultPublicKey = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ==';

      document.getElementById('rsa-private-key').value = defaultPrivateKey;

      window.decryptRSA = function() {
        try {
          const cipher = document.getElementById('rsa-cipher').value.trim();
          const privateKey = document.getElementById('rsa-private-key').value.trim();
          if (!cipher || !privateKey) return showResult('rsa-result', '请输入密文和私钥', true);

          const encryptor = new JSEncrypt();
          encryptor.setPrivateKey(privateKey);
          const result = encryptor.decrypt(cipher);
          showResult('rsa-result', result || '(解密失败，请检查密钥)');
        } catch (e) {
          showResult('rsa-result', 'RSA解密失败: ' + e.message, true);
        }
      };

      window.encryptRSA = function() {
        try {
          const plain = document.getElementById('rsa-cipher').value.trim();
          const publicKey = defaultPublicKey;
          const encryptor = new JSEncrypt();
          encryptor.setPublicKey(publicKey);
          const result = encryptor.encrypt(plain);
          showResult('rsa-result', result || '(加密失败)');
        } catch (e) {
          showResult('rsa-result', 'RSA加密失败: ' + e.message, true);
        }
      };

      // ========== SM2 / SM4 (动态加载) ==========
      let smCryptoLoaded = false;
      let sm2Instance = null;
      let sm4Instance = null;

      async function loadSmCrypto() {
        if (smCryptoLoaded) return;
        const mod = await import('sm-crypto');
        sm2Instance = mod.sm2;
        sm4Instance = mod.sm4;
        smCryptoLoaded = true;
      }

      window.decryptSM2 = async function() {
        try {
          await loadSmCrypto();
          const cipher = document.getElementById('sm2-cipher').value.trim();
          const privateKey = document.getElementById('sm2-private-key').value.trim();
          if (!cipher || !privateKey) return showResult('sm2-result', '请输入密文和私钥', true);

          let raw = cipher;
          if (raw.length > 2 && raw[0] === '0' && raw[1] === '4') {
            raw = raw.substring(2);
          }
          const result = sm2Instance.doDecrypt(raw, privateKey, 1);
          showResult('sm2-result', result || '(SM2解密返回空值，密钥可能不匹配)');
        } catch (e) {
          showResult('sm2-result', 'SM2解密失败: ' + e.message, true);
        }
      };

