      window.utilBase64Encode = function() {
        try {
          const input = document.getElementById('util-input').value;
          showResult('util-result', btoa(unescape(encodeURIComponent(input))));
        } catch (e) { showResult('util-result', '编码失败: ' + e.message, true); }
      };
      window.utilBase64Decode = function() {
        try {
          const input = document.getElementById('util-input').value;
          showResult('util-result', decodeURIComponent(escape(atob(input))));
        } catch (e) { showResult('util-result', '解码失败: ' + e.message, true); }
      };
      window.utilURLEncode = function() {
        showResult('util-result', encodeURIComponent(document.getElementById('util-input').value));
      };
      window.utilURLDecode = function() {
        try { showResult('util-result', decodeURIComponent(document.getElementById('util-input').value)); }
        catch (e) { showResult('util-result', '解码失败: ' + e.message, true); }
      };
      window.utilHexEncode = function() {
        const input = document.getElementById('util-input').value;
        let hex = '';
        for (let i = 0; i < input.length; i++) hex += input.charCodeAt(i).toString(16).padStart(2, '0');
        showResult('util-result', hex);
      };
      window.utilHexDecode = function() {
        try {
          let hex = document.getElementById('util-input').value.replace(/\s/g, '');
          let str = '';
          for (let i = 0; i < hex.length; i += 2) str += String.fromCharCode(parseInt(hex.substr(i, 2), 16));
          showResult('util-result', str);
        } catch (e) { showResult('util-result', '解码失败: ' + e.message, true); }
      };
      window.utilJsonFormat = function() {
        try {
          const input = document.getElementById('util-input').value;
          showResult('util-result', JSON.stringify(JSON.parse(input), null, 2));
        } catch (e) { showResult('util-result', '格式化失败: ' + e.message, true); }
      };
      window.utilJsonMinify = function() {
        try {
          const input = document.getElementById('util-input').value;
          showResult('util-result', JSON.stringify(JSON.parse(input)));
        } catch (e) { showResult('util-result', '压缩失败: ' + e.message, true); }
      };
